# Copy to .env and fill in. NEVER commit .env. No real secrets belong in this file.

# ---- Core ----
# Product name shown in the UI. Change freely.
NEXT_PUBLIC_APP_NAME="Kaam Lahore"
# Public base URL of the site (used to decide whether dev-only features may run).
APP_URL="http://localhost:3000"
# PostgreSQL + PostGIS connection string. The docker-compose.yml DB uses the value below.
DATABASE_URL="postgres://kaam:kaam_local_dev_only@127.0.0.1:5432/kaam"
# Secret (>= 32 chars) used to HMAC OTP codes and rate-limit keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Support/appeal contact shown on privacy, terms and restriction pages.
SUPPORT_EMAIL=""
# Optional PostgreSQL SSL: set to "true" for managed DBs that require TLS.
DATABASE_SSL="false"

# ---- Auth / OTP ----
# Development-only OTP: shows the code on screen instead of sending an SMS.
# Ignored (and logged as an error) when NODE_ENV=production or APP_URL is not localhost.
ENABLE_DEV_OTP="true"
# Comma-separated phone numbers that become admins when they sign in via OTP.
# Leave empty if none. Example format: +923XXXXXXXXX
ADMIN_PHONES=""
# A real Pakistan SMS/OTP provider is NOT implemented. Production sign-in stays unavailable
# until an implementation of OtpProvider (src/lib/otp/provider.ts) is added with its credentials.

# ---- Private file storage ----
# Only "local" (private directory on this server, outside the web root) is implemented.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage-private"
# CNIC/identity uploads. Honoured ONLY outside production with the local driver,
# because no production-grade private object store (e.g. S3 with SSE + signed URLs) is implemented.
ENABLE_IDENTITY_UPLOAD="false"
# Job/work photos on local disk in production. Leave "false" unless you accept
# single-server disk storage (back it up and encrypt the disk).
ALLOW_LOCAL_PHOTO_STORAGE_IN_PROD="false"
# Days to keep an identity document after an admin decision before it is purged.
IDENTITY_RETENTION_DAYS="30"

# ---- Marketplace defaults (admin settings page can override the first five) ----
# Identity policy for bidding: open | pending_ok | verified_only
DEFAULT_IDENTITY_POLICY="pending_ok"
DEFAULT_MATCH_RADIUS_KM="3"
DEFAULT_JOB_EXPIRY_DAYS="7"
DEFAULT_MIN_BIDS_TARGET="3"
DEFAULT_EXPAND_AFTER_HOURS="6"

# ---- Notifications ----
# In-app notifications are always on. Web Push and SMS channels are stubs (not delivering).
PUSH_PROVIDER="none"
SMS_NOTIFICATION_PROVIDER="none"

# ---- Maintenance endpoint ----
# Bearer token for GET /api/cron/maintenance (expire jobs, expand matching, purge ID docs).
# Leave empty to disable the endpoint. `npm run maintenance` works without it.
CRON_SECRET=""

# ---- Seed (optional, development only) ----
# Demo users are created only if these are set to numbers YOU control. Nothing is hard-coded.
SEED_DEMO="false"
DEMO_CUSTOMER_PHONE=""
DEMO_WORKER_PHONE=""
